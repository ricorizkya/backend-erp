# Copy to .env.development.local and replace every placeholder.
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_development
DB_USER=erp_app
DB_PASSWORD=replace_with_a_unique_password

# Redis
REDIS_URL=redis://localhost:6379

# Generate independently: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_a_unique_128_character_secret
JWT_REFRESH_SECRET=replace_with_a_different_128_character_secret

# Optional one-time bootstrap. Remove these after the first successful startup.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_strong_password
# BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
# BOOTSTRAP_ADMIN_TENANT_CODE=admin

ALLOWED_ORIGINS=http://localhost:5173

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=erp-documents
