{
  "info": {
    "name": "ERP Backend — Master Data CRUD Testing",
    "description": "Koleksi lengkap untuk testing semua endpoint CRUD data master.\n\nAlur testing yang disarankan:\n1. AUTH: Login dulu → token otomatis tersimpan\n2. FOUNDATION: UoM → Product Category → Attributes\n3. PRODUCT: Create Product → Create Variants\n4. MASTER LAINNYA: Supplier, Customer, Warehouse, Batch\n\nSemua request sudah pakai variable {{baseUrl}} dan {{accessToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "tenantCode", "value": "admin", "type": "string" },
    { "key": "uomId", "value": "", "type": "string" },
    { "key": "uomId2", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "attributeId", "value": "", "type": "string" },
    { "key": "attributeValueId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "variantId", "value": "", "type": "string" },
    { "key": "supplierId", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "warehouseId", "value": "", "type": "string" },
    { "key": "batchId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 AUTH",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) {", "  const res = pm.response.json();", "  pm.collectionVariables.set('accessToken', res.data.accessToken);", "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);", "  pm.test('Login berhasil', () => pm.response.to.have.status(200));", "  pm.test('Dapat accessToken', () => pm.expect(res.data.accessToken).to.be.a('string'));", "} else { console.log('Login gagal:', pm.response.json()); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@synkro.com\",\n  \"password\": \"Admin@1234\",\n  \"tenantCode\": \"{{tenantCode}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "📏 UOM (Unit of Measure)",
