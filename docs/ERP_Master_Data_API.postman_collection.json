          "name": "GET - List semua UoM",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "const res = pm.response.json();", "pm.test('Response berisi data', () => pm.expect(res.data).to.be.an('array'));"], "type": "text/javascript" } }],
          "request": {
