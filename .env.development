# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=new_erp
DB_USER=synkro_erp
DB_PASSWORD=SynkroERP1826!

# Redis
REDIS_URL=redis://localhost:6379

# JWT — gunakan secret yang panjang dan random di production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=ganti_dengan_random_secret_64_chars_minimum
JWT_REFRESH_SECRET=ganti_dengan_random_secret_berbeda_64_chars_minimum

# CORS — pisahkan dengan koma jika multiple origin
ALLOWED_ORIGINS=http://localhost:5173

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=erp-documents
